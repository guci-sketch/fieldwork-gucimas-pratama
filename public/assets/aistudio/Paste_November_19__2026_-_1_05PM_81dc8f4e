<script>
  // Quick Pest Toggle Interaction
  function togglePest(btn) {
    const isChecked = btn.classList.contains('active-chip');
    const icon = btn.querySelector('.material-symbols-outlined');
    if (isChecked) {
      btn.classList.remove('active-chip', 'bg-primary-container', 'text-on-primary', 'font-semibold', 'shadow-sm');
      btn.classList.add('bg-surface-container', 'text-on-surface');
      icon.textContent = 'add';
      icon.classList.remove('text-on-primary');
      icon.classList.add('text-outline-variant');
    } else {
      btn.classList.add('active-chip', 'bg-primary-container', 'text-on-primary', 'font-semibold', 'shadow-sm');
      btn.classList.remove('bg-surface-container', 'text-on-surface');
      icon.textContent = 'check';
      icon.classList.add('text-on-primary');
      icon.classList.remove('text-outline-variant');
    }
  }

  // Counter helper
  function incrementCount(id) {
    const el = document.getElementById(id);
    let val = parseInt(el.textContent, 10) || 0;
    el.textContent = val + 1;
  }
  function decrementCount(id) {
    const el = document.getElementById(id);
    let val = parseInt(el.textContent, 10) || 0;
    if (val > 1) {
      el.textContent = val - 1;
    }
  }

  // Severity selector
  function setSeverity(level) {
    const buttons = document.querySelectorAll('.sev-btn');
    const desc = document.getElementById('sevDescription');
    buttons.forEach(b => {
      if (b.getAttribute('data-sev') === level) {
        b.className = 'sev-btn py-1.5 rounded text-center font-label-sm text-label-sm transition-colors font-bold bg-secondary text-on-secondary shadow-sm';
      } else {
        b.className = 'sev-btn py-1.5 rounded text-center font-label-sm text-label-sm transition-colors text-on-surface-variant';
      }
    });

    if (level === 'Ringan') {
      desc.textContent = 'Indikasi bekas lama tanpa kerusakan struktur';
    } else if (level === 'Sedang') {
      desc.textContent = 'Jalur aktif terdeteksi pada 2-3 titik kusen';
    } else {
      desc.textContent = 'Infestasi struktural tinggi, perlu follow-up rutin';
    }
  }

  // Service switcher toggle (Anti Rayap <-> Pest Control Umum)
  document.getElementById('serviceSwitcherBtn')?.addEventListener('click', function() {
    const label = document.getElementById('serviceLabel');
    if (label.textContent === 'Anti Rayap') {
      label.textContent = 'Pest Control';
    } else {
      label.textContent = 'Anti Rayap';
    }
  });

  // Custom Treatment Add
  function addCustomTreatment() {
    const input = document.getElementById('customTreatmentInput');
    const text = input.value.trim();
    if (!text) return;

    const container = document.getElementById('customTreatmentContainer');
    const item = document.createElement('div');
    item.className = 'flex items-center justify-between p-3 rounded-lg bg-secondary-container/20';
    item.innerHTML = `
      <div class="flex items-center gap-3">
        <span class="material-symbols-outlined text-[20px] text-secondary">tune</span>
        <div class="flex flex-col">
          <span class="font-label-md text-label-md text-on-surface font-bold">${text}</span>
          <span class="font-body-sm text-body-sm text-secondary">Treatment Kustom Teknisi</span>
        </div>
      </div>
      <button type="button" onclick="this.parentElement.remove()" class="w-8 h-8 rounded-full flex items-center justify-center text-outline hover:text-error active:bg-error-container">
        <span class="material-symbols-outlined text-[18px]">close</span>
      </button>
    `;
    container.appendChild(item);
    input.value = '';
  }

  // Add Custom Area
  function addNewArea() {
    const input = document.getElementById('newAreaInput');
    const text = input.value.trim();
    if (!text) return;

    const container = document.getElementById('areaContainer');
    const label = document.createElement('label');
    label.className = 'flex items-center justify-between p-3 rounded-lg bg-surface-container-low cursor-pointer active:bg-surface-container transition-colors';
    label.innerHTML = `
      <div class="flex items-center gap-2.5">
        <input type="checkbox" checked onchange="updateAreaCount()" class="area-checkbox w-5 h-5 accent-[#1b4332] rounded">
        <span class="font-label-md text-label-md text-on-surface">${text}</span>
      </div>
      <span class="font-body-sm text-body-sm text-on-surface-variant">Area Tambahan</span>
    `;
    container.appendChild(label);
    input.value = '';
    updateAreaCount();
  }

  function updateAreaCount() {
    const checked = document.querySelectorAll('.area-checkbox:checked').length;
    document.getElementById('areaSelectedCount').textContent = checked + ' Area Dipilih';
  }

  // Quick Append recommendation note
  function appendRecommendation(phrase) {
    const textarea = document.querySelector('textarea');
    if (!textarea.value.includes(phrase)) {
      textarea.value = textarea.value.trim() + ' ' + phrase;
    }
  }

  // Signature Canvas Drawing Logic
  let canvas, ctx, isDrawing = false;
  function initCanvas() {
    canvas = document.getElementById('sigCanvas');
    if (!canvas) return;
    ctx = canvas.getContext('2d');
    const rect = canvas.getBoundingClientRect();
    canvas.width = rect.width * 2;
    canvas.height = rect.height * 2;
    ctx.scale(2, 2);
    ctx.strokeStyle = '#012d1d';
    ctx.lineWidth = 2.5;
    ctx.lineCap = 'round';
    ctx.lineJoin = 'round';

    function startDraw(e) {
      isDrawing = true;
      document.getElementById('canvasGuideText').classList.add('opacity-0');
      ctx.beginPath();
      const pos = getPos(e);
      ctx.moveTo(pos.x, pos.y);
    }
    function draw(e) {
      if (!isDrawing) return;
      e.preventDefault();
      const pos = getPos(e);
      ctx.lineTo(pos.x, pos.y);
      ctx.stroke();
    }
    function stopDraw() {
      isDrawing = false;
    }
    function getPos(e) {
      const b = canvas.getBoundingClientRect();
      const clientX = e.touches ? e.touches[0].clientX : e.clientX;
      const clientY = e.touches ? e.touches[0].clientY : e.clientY;
      return { x: clientX - b.left, y: clientY - b.top };
    }

    canvas.addEventListener('mousedown', startDraw);
    canvas.addEventListener('mousemove', draw);
    window.addEventListener('mouseup', stopDraw);
    canvas.addEventListener('touchstart', startDraw, { passive: false });
    canvas.addEventListener('touchmove', draw, { passive: false });
    window.addEventListener('touchend', stopDraw);
  }

  function clearSignatureCanvas() {
    if (!ctx || !canvas) return;
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    document.getElementById('canvasGuideText').classList.remove('opacity-0');
  }

  function openCustomerSignatureModal() {
    const modal = document.getElementById('signModal');
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    setTimeout(() => initCanvas(), 80);
  }

  function closeModal() {
    const modal = document.getElementById('signModal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
  }

  function rateService(val) {
    const buttons = document.querySelectorAll('.star-btn');
    const captions = [
      '1 Bintang: Kurang Memuaskan',
      '2 Bintang: Cukup',
      '3 Bintang: Baik',
      '4 Bintang: Sangat Baik & Tepat Waktu',
      '5 Bintang: Sangat Puas & Bersih'
    ];
    buttons.forEach((btn, idx) => {
      const starIcon = btn.querySelector('.material-symbols-outlined');
      if (idx < val) {
        btn.classList.add('text-secondary');
        btn.classList.remove('text-outline-variant');
        starIcon.style.fontVariationSettings = "'FILL' 1";
      } else {
        btn.classList.remove('text-secondary');
        btn.classList.add('text-outline-variant');
        starIcon.style.fontVariationSettings = "'FILL' 0";
      }
    });
    document.getElementById('ratingCaption').textContent = captions[val - 1];
  }

  function saveSignatureAndFinalize() {
    closeModal();
    document.getElementById('customerSigPlaceholder').classList.add('hidden');
    document.getElementById('customerSigPreview').classList.remove('hidden');

    const toast = document.getElementById('toastSuccess');
    toast.classList.remove('hidden');
    toast.classList.add('flex');
    setTimeout(() => {
      toast.classList.add('hidden');
      toast.classList.remove('flex');
    }, 4500);
  }

  function resetCustomerSignature() {
    document.getElementById('customerSigPlaceholder').classList.remove('hidden');
    document.getElementById('customerSigPreview').classList.add('hidden');
  }

  function submitReportFlow() {
    openCustomerSignatureModal();
  }
</script></main></body></html>

