# Fieldwork App Environment Configuration

# Server & Dev Port (default 3000)
PORT=3000
NODE_ENV=development

# Database URL for PostgreSQL / Cloud SQL (optional - in-memory mock fallback is enabled)
DATABASE_URL=
DB_SSL=false

# Supabase Auth & Storage configuration (optional - demo accounts work out of the box)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Gemini API Key (Server-side)
GEMINI_API_KEY=
